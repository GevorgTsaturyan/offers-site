# Offers site backend
PORT=3010
# Long random string — signs admin login tokens
JWT_SECRET=
# Where the SQLite file lives (default: ./data/offers.db)
DB_PATH=./data/offers.db
# Set when behind nginx so rate limiting sees the real client IP
TRUST_PROXY=1

# Campaign-manager controller (double opt-in subscribe API)
CONTROLLER_URL=https://mailovian.net
# Must equal OFFERS_SITE_KEY in the controller's .env
CONTROLLER_SITE_KEY=
